# Copy to .env and fill in. .env is gitignored — never commit it, and never
# let it into a container image (see .dockerignore).

# --- DEM sources (required) --------------------------------------------------
# Absolute paths to the two nationwide GeoTIFFs. IfSAR (5 m) is preferred and
# SRTM (30 m) is the fallback; the process refuses to start if neither resolves.
EIL_DEM_IFSAR_URI=/srv/eil-data/IfSAR_PH.tif
EIL_DEM_SRTM_URI=/srv/eil-data/SRTM30m.tif

# Developer convenience only: search mounted removable volumes for
# eil-calc/IfSAR/IfSAR_PH.tif when the URIs above are unset. Leave this off on
# a server — it is a filesystem walk that can only ever fail there.
# EIL_DEM_ALLOW_REMOVABLE_SCAN=1

# --- HTTP --------------------------------------------------------------------
# Bind address for `python api.py`. Loopback is correct in the deployment
# topology: the reverse proxy is the only thing that should reach uvicorn.
# EIL_HOST=127.0.0.1
# EIL_PORT=8000
# EIL_RELOAD=1

# Cross-origin callers. Normally empty — the SPA is served from the same origin
# as /api/ in production, and proxied through Vite in development.
# EIL_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- Ground-truth tooling ----------------------------------------------------
# Used only by generate_mock_parcels.py to authenticate against the PHIVOLCS
# ArcGIS Portal. Not read by the API.
# PHIVOLCS_PASSWORD=
